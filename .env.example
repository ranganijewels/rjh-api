# App
NODE_ENV=development
PORT=4000
APP_NAME="RJ House API"

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rjhouse
DB_PASSWORD=rjhouse_secret
DB_NAME=rjhouse_db
DB_SSL=false

# JWT (RS256) - generate with: openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_EMAIL=rjhouse_email
RABBITMQ_QUEUE_NOTIFICATION=rjhouse_notification
RABBITMQ_QUEUE_AUDIT=rjhouse_audit
RABBITMQ_QUEUE_JOBS=rjhouse_jobs

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@rjhouse.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="RJ House <noreply@rjhouse.com>"

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://rjhouse.com,https://admin.rjhouse.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT_PUBLIC=100
THROTTLE_LIMIT_AUTH=500

# Default Tenant (for single-tenant mode)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# OpenAI (for AI Sales Agents)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude (for AI product-listing copy generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Public URLs — used to build the Cashfree return_url (storefront) and
# notify_url (this API's own webhook endpoint, must be publicly reachable).
STOREFRONT_URL=https://www.therjhouse.com
API_PUBLIC_URL=https://api.therjhouse.com

# Cashfree Payment Gateway — get from Developers > API Keys in the Cashfree
# dashboard. CASHFREE_ENV must be "sandbox" while testing, "production" to
# go live (this switches the API base URL — the App ID/Secret pair differs
# between the two, so both must be swapped together).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
